{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "squareone-cockpit",
  "version": "1.0.1",
  "description": "Work on your explicitly shared Cockpit tasks and return deliverables for human review.",
  "author": {
    "name": "株式会社スクエアワン",
    "url": "https://square-one.co.jp"
  },
  "homepage": "https://cockpit.square-one.co.jp/plugins/cockpit",
  "license": "LicenseRef-Proprietary",
  "keywords": [
    "tasks",
    "meetings",
    "productivity",
    "cockpit"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SQUAREONE Cockpit",
        "shortDescription": "Tasks to reviewed deliverables",
        "longDescription": "Work on your explicitly shared Cockpit tasks and return deliverables for human review.",
        "developerName": "株式会社スクエアワン",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://cockpit.square-one.co.jp/plugins/cockpit",
        "privacyPolicyURL": "https://cockpit.square-one.co.jp/privacy",
        "termsOfServiceURL": "https://cockpit.square-one.co.jp/terms",
        "defaultPrompt": [
          "List the Cockpit tasks I shared with my AI.",
          "Work on my selected Cockpit task and submit the result for review.",
          "Show the results submitted for my Cockpit task."
        ],
        "brandColor": "#06224A",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png",
        "supportURL": "https://cockpit.square-one.co.jp/plugins/cockpit#support"
      }
    }
  },
  "repository": "https://github.com/RICK-ORPHEN/squareone-cockpit-plugin"
}
